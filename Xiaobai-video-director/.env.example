# Copy to .env locally. Do not source this file or include .env in a skill package.
# Independent runtime. No workshop directory, database or queue is required.
TTS_PROTOCOL=tencent_speech
TTS_BASE_URL=https://tts.tencentcloudapi.com
TTS_MODEL=1
TTS_VOICE_ID=1001
# This is the director's multiplier, not Tencent's raw Speed parameter.
TTS_SPEED=1.1
PLAYBACK_RATE=0.92
TTS_LANGUAGE=zh-CN

# Needed for new speech synthesis. Never paste keys into a chat.
TTS_SECRET_ID=
TTS_SECRET_KEY=
